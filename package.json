{
  "name": "hvor-er-den",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:e2e": "ng build --base-href /hvor-er-den/ --output-path dist/e2e",
    "preview": "node scripts/serve.mjs --dir dist/hvor-er-den/browser --base / --port 4200",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "e2e": "npm run build:e2e && playwright test",
    "e2e:only": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "app-icons": "node scripts/gen-app-icons.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run e2e"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "minisearch": "^7.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@material-symbols/svg-400": "^0.49.0",
    "@playwright/test": "^1.63.0",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.0.0"
  }
}
